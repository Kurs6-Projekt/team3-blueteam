{
  "groups": {
    "group:students": [
      "marcus@",
      "andre@",
      "carl@",
      "erik@",
      "jonathan@",
      "viktor@"
    ],

    "group:admins": [
      "admin@"
    ],

    "group:developers": [
      "developer@"
    ],

    "group:employees": [
      "employee@"
    ]
  },

  "acls": [
    // Teamet behöver full åtkomst för att administrera
    // och genomföra övningarna i labbmiljön
    {
      "action": "accept",
      "src": ["group:students"],
      "dst": ["*:*"]
    },

    // Administratörer får full åtkomst till företagets interna nät
    {
      "action": "accept",
      "src": ["group:admins"],
      "dst": ["10.0.3.0/24:*"]
    },

    // Utvecklare får SSH samt HTTP/HTTPS till interna resurser
    {
      "action": "accept",
      "src": ["group:developers"],
      "dst": ["10.0.3.0/24:22,80,443"]
    },

    // Vanliga anställda får endast använda webbtjänster
    {
      "action": "accept",
      "src": ["group:employees"],
      "dst": ["10.0.3.0/24:80,443"]
    }
  ]
}
