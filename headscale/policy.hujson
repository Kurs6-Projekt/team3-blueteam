{
  "groups": {
    // Labbmiljön: riktiga användare i Headscale
    "group:students":   ["marcus@", "andre@", "carl@", "erik@", "jonathan@", "viktor@"],
    "group:instruktor": ["dennis@"],

    // Fiktivt företag: tre roller med olika behov
    "group:it-drift":   ["sara@", "omar@"],
    "group:utvecklare": ["elin@", "noah@"],
    "group:anstallda":  ["petra@", "jonas@"]
  },

  // Endast IT-drift får sätta taggar. Utan den här spärren kan vem som
  // helst tagga sin egen maskin som tag:db och därmed ge sig själv
  // databasens behörigheter.
  "tagOwners": {
    "tag:webb": ["group:it-drift"],
    "tag:db":   ["group:it-drift"],
    // GitHub Actions registrerar sin tillfälliga runner med denna tagg.
    "tag:github-runner": ["github-ci@"]
  },

  "acls": [
    // GitHub-runnern får endast nå Kubernetes API:t på primary.
    {
      "action": "accept",
      "src":    ["tag:github-runner"],
      "dst":    ["10.0.3.3:6443"]
    },
    {
      "action": "accept",
      "src":    ["tag:github-runner"],
      "proto":  "icmp",
      "dst":    ["10.0.3.3:*"]
    },

    // ---------- Labbmiljö ----------
    // Styr på adresser, eftersom vi har fasta adresser att peka på.

    // Jumphosten: SSH och DNS. Den här regeln måste finnas.
    // Saknas port 22 låser vi ut oss från maskinen som kör Headscale.
    {
      "action": "accept",
      "src":    ["group:students", "group:instruktor"],
      "dst":    ["100.64.0.2:22,53"]
    },

    // Teamets interna subnät, annonserat av jumphosten som subnet router.
    {
      "action": "accept",
      "src":    ["group:students", "group:instruktor"],
      "dst":    ["10.0.3.0/24:*"]
    },

    // Spectre. Endast HTTPS, inget annat behövs.
    {
      "action": "accept",
      "src":    ["group:students", "group:instruktor"],
      "dst":    ["10.0.0.2/32:443"]
    },

    // ---------- Fiktivt företag ----------
    // Styr på taggar i stället för adresser. Servrar byts ut och får nya
    // adresser, men rollen består. Ingen nod bär taggarna i vår labbmiljö
    // eftersom vi inte har några servrar i tailnetet att tagga.

    // IT-drift administrerar servrarna.
    {
      "action": "accept",
      "src":    ["group:it-drift"],
      "dst":    ["tag:webb:*", "tag:db:*"]
    },

    // Utvecklare felsöker webbservrarna men når aldrig databasen direkt.
    {
      "action": "accept",
      "src":    ["group:utvecklare"],
      "dst":    ["tag:webb:22,80,443"]
    },

    // Anställda använder webbtjänsten och inget annat.
    {
      "action": "accept",
      "src":    ["group:anstallda"],
      "dst":    ["tag:webb:80,443"]
    },

    // Applikationen når databasen. Ingen människa gör det direkt.
    {
      "action": "accept",
      "src":    ["tag:webb"],
      "dst":    ["tag:db:5432"]
    }
  ]
}
